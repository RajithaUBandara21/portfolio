# Copy this file to .env for local development (docker-compose reads .env automatically).

NODE_ENV=development

# PostgreSQL connection strings. The docker-compose Postgres service matches these by default.
# DATABASE_URL is used at runtime by the Prisma driver adapter (point this at a pooled
# connection string in production, e.g. Neon's pooler). DIRECT_URL is used by Prisma Migrate
# and must be an unpooled connection. Locally these can be identical.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
DIRECT_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Session cookie configuration
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7

# Used only by `prisma/seed.ts` to create the initial admin user. Never commit real values.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now-min-8-chars

# Optional: GitHub integration (repo stats). Feature degrades gracefully if unset.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Optional: Vercel Blob for file uploads. Falls back to local public/uploads/ if unset.
BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis for contact-form rate limiting. Falls back to a Postgres-backed
# fixed-window limiter if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for metadata/OG tags/canonical URLs/sitemap/robots.txt.
# In production (Vercel), set this to the real custom domain: NEXT_PUBLIC_SITE_URL=https://rajithabandara.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
