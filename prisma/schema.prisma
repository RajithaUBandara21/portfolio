generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectCategory {
  AI_ML
  SOFTWARE_ENGINEERING
  DISTRIBUTED_SYSTEMS
  CLOUD
  DEVOPS
  RESEARCH
  BACKEND
  FRONTEND
  MOBILE
  DATA_ENGINEERING
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MAINTAINED
  ARCHIVED
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  RUNTIME_ENVIRONMENT
  DATABASE
  CLOUD_DEVOPS
  TOOLING
  SOFT_SKILL
  OTHER
}

enum SkillLevel {
  FAMILIAR
  PROFICIENT
  ADVANCED
  EXPERT
}

enum ArchNodeKind {
  SERVICE
  DATABASE
  QUEUE
  CACHE
  CLIENT
  EXTERNAL_API
  GATEWAY
  STORAGE
  OTHER
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

// ---------- Auth ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipHash    String?

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Profile / Social ----------

model Profile {
  id              String       @id @default(cuid())
  fullName        String
  headline        String
  bio             String       @db.Text
  avatarUrl       String?
  resumeUrl       String?
  location        String?
  email           String?
  phone           String?
  availability    String?
  yearsExperience Int?
  updatedAt       DateTime     @updatedAt
  socialLinks     SocialLink[]
}

model SocialLink {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  order     Int     @default(0)

  @@index([profileId])
}

// ---------- Technologies & Skills ----------

model Technology {
  id       String              @id @default(cuid())
  name     String              @unique
  slug     String              @unique
  iconKey  String?
  projects ProjectTechnology[]

  @@index([slug])
}

model Skill {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  category    SkillCategory
  level       SkillLevel
  description String?        @db.Text
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projects    ProjectSkill[]

  @@index([slug])
  @@index([category])
}

// ---------- Projects ----------

model Project {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  shortDescription  String
  fullDescription   String            @db.Text

  categories        ProjectCategory[]
  status            ProjectStatus     @default(PLANNED)
  contentStatus     ContentStatus     @default(DRAFT)
  featured          Boolean           @default(false)

  startDate         DateTime?
  endDate           DateTime?

  githubUrl         String?
  demoUrl           String?
  docsUrl           String?

  problem            String? @db.Text
  solution            String? @db.Text
  architectureNotes   String? @db.Text
  challenges          String? @db.Text
  results             String? @db.Text
  lessons             String? @db.Text
  futureImprovements  String? @db.Text
  reliabilityNotes    String? @db.Text
  securityNotes        String? @db.Text
  observabilityNotes String? @db.Text
  testingNotes        String? @db.Text

  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  technologies      ProjectTechnology[]
  skills            ProjectSkill[]
  screenshots       ProjectScreenshot[]
  metrics           ProjectMetric[]
  decisions         ProjectDecision[]
  archNodes         ArchitectureNode[]
  archEdges         ArchitectureEdge[]

  @@index([slug])
  @@index([contentStatus, featured])
  @@index([categories], type: Gin)
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ProjectScreenshot {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  order     Int     @default(0)

  @@index([projectId])
}

model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  value     String
  context   String?
  order     Int     @default(0)

  @@index([projectId])
}

model ProjectDecision {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  reason       String  @db.Text
  alternatives String  @db.Text
  tradeoffs    String  @db.Text
  order        Int     @default(0)

  @@index([projectId])
}

// ---------- Architecture Diagram ----------

model ArchitectureNode {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key             String
  label           String
  kind            ArchNodeKind @default(SERVICE)
  technology      String?
  responsibility  String?      @db.Text
  interfaces      String[]
  dependencies    String[]
  positionX       Float        @default(0)
  positionY       Float        @default(0)

  outgoingEdges ArchitectureEdge[] @relation("EdgeSource")
  incomingEdges ArchitectureEdge[] @relation("EdgeTarget")

  @@unique([projectId, key])
  @@index([projectId])
}

model ArchitectureEdge {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId  String
  targetId  String
  source    ArchitectureNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    ArchitectureNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  label     String?
  dataFlow  String?

  @@index([projectId])
  @@index([sourceId])
  @@index([targetId])
}

// ---------- Experience / Education / Certifications ----------

model Experience {
  id            String        @id @default(cuid())
  company       String
  role          String
  location      String?
  startDate     DateTime
  endDate       DateTime?
  current       Boolean       @default(false)
  summary       String        @db.Text
  highlights    String[]
  technologies  String[]
  order         Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus])
}

model Education {
  id            String        @id @default(cuid())
  institution   String
  degree        String
  fieldOfStudy  String?
  startDate     DateTime
  endDate       DateTime?
  current       Boolean       @default(false)
  description   String?       @db.Text
  order         Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus])
}

model Certification {
  id            String           @id @default(cuid())
  name          String
  issuer        String
  category      ProjectCategory?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialUrl String?
  fileUrl       String?
  order         Int              @default(0)
  contentStatus ContentStatus    @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([contentStatus])
  @@index([category])
}

// ---------- Blog ----------

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  contentMdx     String        @db.Text
  coverImageUrl  String?
  readingTimeMin Int?
  contentStatus  ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags BlogPostTag[]

  @@index([slug])
  @@index([contentStatus, publishedAt])
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String        @unique
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ---------- Activities ----------

model Activity {
  id            String        @id @default(cuid())
  title         String
  type          String
  description   String?       @db.Text
  url           String?
  date          DateTime
  order         Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus, date])
}

// ---------- Contact ----------

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  ipHash    String?
  userAgent String?
  createdAt DateTime             @default(now())

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}
